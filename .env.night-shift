# ============================================
# HếtChờ — Night Shift Mock Environment
# ============================================
# Tất cả key là FAKE — không gọi API thật.
# Mock adapters trong packages/infrastructure/mock/* sẽ trả response giả lập.

NODE_ENV=development
NIGHT_SHIFT_MODE=true

# Local SQLite cho test (KHÔNG chạm Supabase)
DATABASE_URL=file:./data/hetcho-night.sqlite
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=FAKE_KEY_DO_NOT_USE
SUPABASE_SERVICE_ROLE_KEY=FAKE_KEY_DO_NOT_USE

UPSTASH_REDIS_REST_URL=http://localhost:6379
UPSTASH_REDIS_REST_TOKEN=FAKE_KEY_DO_NOT_USE

ZALO_OA_ID=fake-oa-id
ZALO_OA_ACCESS_TOKEN=FAKE_KEY_DO_NOT_USE
ZALO_MINI_APP_ID=fake-mini-app
ZALO_MINI_APP_SECRET=FAKE_KEY_DO_NOT_USE

VNPAY_TMN_CODE=FAKE
VNPAY_HASH_SECRET=FAKE_KEY_DO_NOT_USE
VNPAY_RETURN_URL=http://localhost:3000/api/webhooks/vnpay
VNPAY_API_URL=http://localhost:3000/__mock__/vnpay

MOMO_PARTNER_CODE=FAKE
MOMO_ACCESS_KEY=FAKE_KEY_DO_NOT_USE
MOMO_SECRET_KEY=FAKE_KEY_DO_NOT_USE

ZALOPAY_APP_ID=FAKE
ZALOPAY_KEY1=FAKE_KEY_DO_NOT_USE
ZALOPAY_KEY2=FAKE_KEY_DO_NOT_USE

RESEND_API_KEY=FAKE_KEY_DO_NOT_USE
EMAIL_FROM=noreply@hetcho.local

SENTRY_DSN=
BETTERSTACK_LOGTAIL_TOKEN=
POSTHOG_API_KEY=

GOOGLE_CLIENT_ID=fake-client-id
GOOGLE_CLIENT_SECRET=FAKE_KEY_DO_NOT_USE

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
