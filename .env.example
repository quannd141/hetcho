# ============================================
# HếtChờ — Environment Variables (Template)
# ============================================
# Copy thành .env.local cho dev, fill key thật.
# KHÔNG commit .env hoặc .env.local.
# Khi night-shift chạy → dùng .env.night-shift (mock keys).

NODE_ENV=development
NIGHT_SHIFT_MODE=false

# --- Database (Supabase Postgres) ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/hetcho
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Redis (Upstash) ---
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# --- Zalo OA + Mini App ---
ZALO_OA_ID=your-oa-id
ZALO_OA_ACCESS_TOKEN=your-oa-token
ZALO_MINI_APP_ID=your-mini-app-id
ZALO_MINI_APP_SECRET=your-mini-app-secret
ZNS_TEMPLATE_REMINDER_24H=your-template-id
ZNS_TEMPLATE_REMINDER_2H=your-template-id

# --- Payment Gateways ---
VNPAY_TMN_CODE=your-tmn-code
VNPAY_HASH_SECRET=your-hash-secret
VNPAY_RETURN_URL=https://app.hetcho.vn/api/webhooks/vnpay
VNPAY_API_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

MOMO_PARTNER_CODE=your-partner-code
MOMO_ACCESS_KEY=your-access-key
MOMO_SECRET_KEY=your-secret-key

ZALOPAY_APP_ID=your-app-id
ZALOPAY_KEY1=your-key1
ZALOPAY_KEY2=your-key2

# --- Email (Resend) ---
RESEND_API_KEY=your-resend-key
EMAIL_FROM=noreply@hetcho.vn

# --- Observability ---
SENTRY_DSN=your-sentry-dsn
BETTERSTACK_LOGTAIL_TOKEN=your-logtail-token
POSTHOG_API_KEY=your-posthog-key

# --- Google Calendar OAuth ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- App URLs ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
